# Supabase infrastructure is shared. FreeResumePost rows and RPCs are source-scoped.
NEXT_PUBLIC_SUPABASE_URL=https://tsruqbodyrmxqzhvxret.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<set-from-supabase-dashboard-api-keys>
# Server Actions only. Never expose this value through a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=<set-from-supabase-dashboard-api-keys>

# Cloudflare Turnstile (anti-spam on resume upload)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<set-when-turnstile-widget-created>
TURNSTILE_SECRET_KEY=<server-side-only>

# /account/tailor — resume/cover-letter tailoring, free for signed-in candidates
# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Signs the fr_tailor_usage daily-limit cookie (abuse/cost guard only, not
# payment-related). Any long random string.
TAILOR_COOKIE_SECRET=
