{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeresumepost",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "cache": {
    "enabled": true
  },
  "routes": [
    { "pattern": "freeresumepost.co/*", "zone_name": "freeresumepost.co" },
    { "pattern": "www.freeresumepost.co/*", "zone_name": "freeresumepost.co" }
  ],
  "workers_dev": true,
  "vars": {
    // OpenNext's DO revalidation queue bills the full timeout as Durable
    // Object "duration" on every ISR revalidation, regardless of how fast
    // the fetch actually completes (acknowledged upstream as "problematic"
    // in durable-objects/queue.js). Default is 10s; this account was hitting
    // the free-tier daily DO duration cap every day for ~2 weeks. Lowering
    // this caps the worst case per-revalidation cost -- self-referenced
    // fetches to our own Worker should complete in well under 3s normally.
    "NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS": "3000"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // See alpha/wrangler.jsonc for why this is here -- same asset-layer-vs-
    // Worker precedence issue found on toggletown and baselens.
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "freeresumepost-inc-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "28d3df97-14ce-449c-a7ae-376c6c66d8f8",
      "database_name": "freeresumepost-tag-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "freeresumepost"
    }
  ]
}
